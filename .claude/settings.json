{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force-with-lease origin main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/scripts/lib/specflow/push_guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r .tool_input.file_path); case \"$f\" in */docs/specs/*.md|*/docs/plans/*.md) ;; *) exit 0 ;; esac; out=$(bash \"$CLAUDE_PROJECT_DIR/scripts/verify-doc.sh\" \"$f\" 2>&1) || true; if [ -n \"$out\" ]; then echo \"$out\" >&2; exit 2; fi; exit 0"
          }
        ]
      }
    ]
  }
}
